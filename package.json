{
  "name": "statekit",
  "private": true,
  "version": "0.0.0",
  "description": "The intelligent presentation layer for React applications.",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @statekitjs/react build",
    "dev": "pnpm --filter @statekitjs/react storybook",
    "playground": "pnpm --filter @statekit/playground dev",
    "test": "pnpm --filter @statekitjs/react test",
    "test:watch": "pnpm --filter @statekitjs/react test:watch",
    "typecheck": "pnpm --filter @statekitjs/react typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @statekitjs/react storybook",
    "build-storybook": "pnpm --filter @statekitjs/react build-storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.30.1",
    "@types/node": "^26.1.2",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  },
  "keywords": [
    "react",
    "typescript",
    "ui",
    "state",
    "loading",
    "empty",
    "error",
    "react-library"
  ]
}
